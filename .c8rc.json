{
  "extension": [".ts", ".tsx"],
  "include": [
    "shared/**",
    "daemon/**",
    "web/src/lib/**"
  ],
  "exclude": [
    "test/**",
    "corpus/**",
    "out/**",
    "dist/**",
    "node_modules/**",
    "web/.next/**",
    "**/*.test.ts",
    "**/*.d.ts",
    "shared/protocol.js",
    "daemon/dist/**"
  ],
  "all": true,
  "reporter": ["text", "text-summary"]
}
