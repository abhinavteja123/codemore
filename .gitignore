*.log
npm-debug.log*

# Test coverage
coverage/

# CLI publish output — only the root-level lib/ from tsconfig.publish.json.
# Bare `lib/` would also match every nested src/lib, daemon/lib, etc., which
# are real source directories.
/lib/
codemore-*.tgz

# Self-test corpus clones (samples.json drives this)
.samples-cache/
SAMPLES_REPORT.md


# Legacy extension issue exports — one-off audit artefacts, not source.
codemore-issues-*.json
ai mentor bugs.json

# graphify knowledge-graph artifacts — generated locally with /graphify,
# regenerable from source, not needed in the repo.
graphify-out/
.graphify_*

# Triage results — local-only audit output. Must never be committed.
triage-results/
