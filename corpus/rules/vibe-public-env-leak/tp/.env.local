# True-positive fixture for vibe-public-env-leak
# Five distinct public-prefix-with-secret-fragment combinations the rule MUST flag.

# 1. The Moltbook pattern — service role key shipped to client (BLOCKER).
NEXT_PUBLIC_SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.real.key

# 2. Vite-prefixed private key (BLOCKER).
VITE_STRIPE_SECRET_KEY=sk_live_51N3xampleStripeSecretValue

# 3. CRA-prefixed database url (BLOCKER).
REACT_APP_DATABASE_URL=postgres://user:pw@db.internal/prod

# 4. Astro-prefixed admin key (BLOCKER).
PUBLIC_ADMIN_KEY=ak_prod_1234567890abcdef

# 5. Expo-prefixed secret (BLOCKER, even with quoted value).
EXPO_PUBLIC_OPENAI_API_KEY="sk-proj-realkeyvalue"

# Server-only keys should NOT be flagged.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiJ9.server.only
DATABASE_URL=postgres://server:only@db.internal/prod
