# False-positive fixture for vibe-public-env-leak
# All assignments here MUST NOT trigger the rule.

# Public vars that genuinely belong on the client.
NEXT_PUBLIC_SUPABASE_URL=https://abcdef.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.anon.key
NEXT_PUBLIC_APP_NAME="My Vibe App"
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
